# Sieve agent image for the OpenShell sandbox: repo, dependencies and the prebuilt index, nothing else.
FROM python:3.12-slim
ENV PYTHONIOENCODING=utf-8 PIP_NO_CACHE_DIR=1
RUN pip install uv
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --frozen
COPY packages ./packages
COPY apps/mcp ./apps/mcp
COPY scripts/install_paths.py ./scripts/install_paths.py
RUN uv run python scripts/install_paths.py
COPY data/index ./data/index
COPY data/external ./data/external
COPY data/samples ./data/samples
# OpenShell runs the workload as a non-root sandbox identity: make the workspace usable by any uid.
RUN chmod -R a+rwX /workspace
# Credentials come from OpenShell providers at run time; nothing baked in.
CMD ["sleep", "infinity"]
